{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/", "destination": "/index.html" },
    { "source": "/admin/register", "destination": "/index.html" },
    { "source": "/admin/register/", "destination": "/index.html" },
    { "source": "/places/:slug", "destination": "/index.html" }
  ]
}
